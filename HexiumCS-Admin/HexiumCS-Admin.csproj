<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HexiumCSAdmin</RootNamespace>
    <AssemblyName>HexiumCS-Admin</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <BaseOutputPath>bin\</BaseOutputPath>
    <OutputPath>$(BaseOutputPath)$(Configuration)\addons\counterstrikesharp\plugins\HexiumCS-Admin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.379">
      <PrivateAssets>none</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Resolved from counterstrikesharp/shared at runtime; not copied locally. -->
  <ItemGroup>
    <Reference Include="HexiumCS-UI">
      <HintPath>..\..\HexiumCS-UI\HexiumCS-UI\bin\$(Configuration)\addons\counterstrikesharp\shared\HexiumCS-UI\HexiumCS-UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
